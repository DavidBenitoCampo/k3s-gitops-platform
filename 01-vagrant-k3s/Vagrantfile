# frozen_string_literal: true
#
# Inception of Things - Phase 1
# Two-node K3s cluster provisioned with Vagrant.
#   benyS  (control-plane) -> 192.168.56.110
#   benySW (agent/worker)  -> 192.168.56.111

IP_SERVER     = "192.168.56.110"
IP_AGENT      = "192.168.56.111"
BOX_IMAGE     = "ubuntu/noble64"   # Ubuntu 24.04 LTS, latest stable
FLANNEL_IFACE = "eth1"

Vagrant.configure("2") do |config|
  config.vm.box = BOX_IMAGE
  config.vm.box_check_update = false
  config.vm.boot_timeout = 600

  # Vagrant inserts a fresh SSH keypair per VM by default (config.ssh.insert_key
  # is true out of the box), which is what gives us passwordless `vagrant ssh`.
  # No extra config needed here.

  # --- Control plane -----------------------------------------------------
  config.vm.define "benyS" do |server|
    server.vm.hostname = "benyS"
    server.vm.network "private_network", ip: IP_SERVER

    server.vm.provider "virtualbox" do |vb|
      vb.name   = "benyS"
      vb.cpus   = 1
      vb.memory = 1024
    end

    server.vm.provision "shell",
      path: "scripts/install-k3s-server.sh",
      env: {
        "NODE_IP"       => IP_SERVER,
        "FLANNEL_IFACE" => FLANNEL_IFACE
      }

    server.vm.provision "shell", path: "scripts/install-kubectl.sh"
  end

  # --- Worker --------------------------------------------------------------
  config.vm.define "benySW" do |agent|
    agent.vm.hostname = "benySW"
    agent.vm.network "private_network", ip: IP_AGENT

    agent.vm.provider "virtualbox" do |vb|
      vb.name   = "benySW"
      vb.cpus   = 1
      vb.memory = 1024
    end

    agent.vm.provision "shell",
      path: "scripts/install-k3s-agent.sh",
      env: {
        "NODE_IP"       => IP_AGENT,
        "SERVER_IP"     => IP_SERVER,
        "FLANNEL_IFACE" => FLANNEL_IFACE
      }
  end
end
